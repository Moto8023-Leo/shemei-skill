{
  "buildCommand": "cd web && npm install && npm run build && cp dist/index.html ../index.html",
  "outputDirectory": "web/dist",
  "functions": {
    "api/generate.ts": { "maxDuration": 55 },
    "api/publish.ts": { "maxDuration": 55 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
