# ============================================================
# Social Auto-Poster API Tokens
# Copy this file to .env and fill in your tokens
# ============================================================

# Anthropic Claude API（AI content generation, optional）
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# X (Twitter) — twikit cookie-based (free, no official API key needed)
# Setup: python scripts/x_api.py --set-cookies
# (You MUST manually extract cookies from Chrome once)

# Facebook Graph API (FREE, unlimited)
# See docs/FB_SETUP_GUIDE.md for step-by-step instructions
# Get Page Access Token from: https://developers.facebook.com/tools/explorer/
# Required permissions: pages_manage_posts, pages_read_engagement
FB_PAGE_ID=your-page-id-here
FB_ACCESS_TOKEN=your-long-lived-page-access-token-here

# Instagram Graph API via Facebook (FREE, unlimited)
# Instagram must be a Business/Creator account connected to your FB Page
# Required permissions: instagram_basic, instagram_content_publish
IG_USER_ID=your-instagram-business-account-id-here

# Feishu Bitable integration (Optional but recommended)
# Simpler method — PersonalBaseToken (no app creation needed):
#   Open your Bitable → top-right "..." → "获取授权码" → Enable → Copy token
# Or enterprise method — App credentials:
#   Create app at https://open.feishu.cn → get App ID + App Secret
FEISHU_PERSONAL_BASE_TOKEN=your-personal-base-token-here
# FEISHU_APP_ID=your-app-id-here           # Only if using app credentials
# FEISHU_APP_SECRET=your-app-secret-here   # Only if using app credentials
FEISHU_APP_TOKEN=your-base-app-token-here     # From the Bitable URL
FEISHU_TABLE_ID=your-table-id-here            # From the Bitable URL
